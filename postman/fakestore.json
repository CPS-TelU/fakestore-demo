{
  "info": {
    "name": "Fakestore Demo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "token", "value": "" },
    { "key": "newUsername", "value": "namakalian" },
    { "key": "newPassword", "value": "isipassword" },
    { "key": "productId", "value": "1" }
  ],
  "item": [
    {
      "name": "Database & Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/register",
            "description": "Membuat baris baru di tabel users. Password polos di-hash bcrypt oleh backend, bukan hash manual."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"mor_2314\",\n  \"password\": \"83r5^_\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/login",
            "description": "Username dan password dicek ke tabel users dengan bcrypt/SHA2. Token UUID disimpan ke tabel sessions. Token otomatis disimpan ke variabel {{token}}."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/me",
            "description": "Mengambil user dari JOIN tabel sessions dan users berdasarkan Bearer token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Products",
      "item": [
        {
          "name": "Get All Products",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products",
            "description": "SELECT semua baris dari tabel products."
          },
          "response": []
        },
        {
          "name": "Get Product By Id",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "SELECT satu baris products berdasarkan primary key id."
          },
          "response": []
        },
        {
          "name": "Get Categories",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/categories",
            "description": "SELECT DISTINCT category dari tabel products."
          },
          "response": []
        },
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('productId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Produk dari Postman\",\n  \"price\": 19.99,\n  \"description\": \"Contoh INSERT ke tabel products\",\n  \"category\": \"insert-manual\",\n  \"image\": \"\",\n  \"rating\": { \"rate\": 4.5, \"count\": 10 }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products",
            "description": "INSERT baris baru dengan source='manual'. Perlu Bearer token. Id hasil disimpan ke variabel {{productId}}."
          },
          "response": []
        },
        {
          "name": "Update Product",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Produk sudah diupdate\",\n  \"price\": 24.99,\n  \"description\": \"Contoh UPDATE tabel products\",\n  \"category\": \"insert-manual\",\n  \"image\": \"\",\n  \"rating\": { \"rate\": 4.8, \"count\": 12 }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "UPDATE baris products sesuai {{productId}}. Perlu Bearer token."
          },
          "response": []
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/api/products/{{productId}}",
            "description": "DELETE baris products sesuai {{productId}}. Perlu Bearer token."
          },
          "response": []
        }
      ]
    }
  ]
}
